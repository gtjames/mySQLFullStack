<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Titanic Passengers</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/css/bootstrap.min.css">
</head>
<body class="container" style="margin-top: 50px;">

<% if (messages.success) { %>
    <div class="alert alert-success" role="alert"><%- messages.success %></div>
<% } %>

<% if (messages.error) { %>
    <div class="alert alert-danger" role="alert"><%- messages.error %></div>
<% } %>

<div class="card">
    <div class="card-header">
        <ul class="nav nav-pills w-100">
            <li class="nav-pill active">
                <a class="nav-link">Titanic Passengers</a>
            </li>
            <li class="nav-pill">
                <a class="nav-link" href="/">Home</a>
            </li>
            <li class="nav-pill">
                <a class="nav-link" href="/titanic">All Passengers</a>
            </li>
            <form action="/titanic/search" method="post">
                <select name="attrib" id="attrib">
                    <option value="lastName">       Last Name         </option>
                    <option value="firstName">      First Name        </option>
                    <option value="age">            Age               </option>
                    <option value="class">          Class             </option>
                    <option value="passengerOrCrew">Passenger or Crew </option>
                    <option value="role">           Role              </option>
                    <option value="survivor">       Survivor          </option>
                    <option value="gender">         Gender            </option>
                </select>
                <input id="search" name="search" type="text">
            </form>
            <li class="nav-pill ml-auto">
                <a class="nav-link active" href="/titanic/add">Add Passenger</a>
            </li>
        </ul>
    </div>
    <div class="card-body">

        <% if(data.length) { %>
            <table class="table sortable table-hover table-striped">
                <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Last Name</th>
                    <th scope="col">First Name</th>
                    <th scope="col">Age</th>
                    <th scope="col">Class</th>
                    <th scope="col">Passenger or Crew</th>
                    <th scope="col">Role</th>
                    <th scope="col">Survivor</th>
                    <th scope="col">Gender</th>
                    <th width="200px">Action</th>
                </tr>
                </thead>
                <tbody>
                <% for(var i = 0; i< data.length; i++) { %>
                    <tr>
                        <th scope="row"><%= (i+1) %></th>
                        <td><%= data[i].lastName%></td>
                        <td><%= data[i].firstName%></td>
                        <td><%= data[i].age%></td>
                        <td><%= data[i].class%></td>
                        <td><%= data[i].passengerOrCrew%></td>
                        <td><%= data[i].role%></td>
                        <td><%= data[i].survivor%></td>
                        <td><%= data[i].gender%></td>
                        <td>
                            <a class="btn btn-success edit" href="../titanic/edit/<%=data[i].id%>">Edit</a>
                            <a class="btn btn-danger delete" onclick="return alert('Are You sure?')" href="../titanic/delete/<%=data[i].id%>">Delete</a>
                        </td>
                    </tr>
                <% } %>
                </tbody>
            </table>
        <% } %>

        <!-- if result is empty -->
        <% if(!data.length) { %>
            <p class="text-center">No Passenger found!</p>
        <% } %>

    </div>
</div>

</body>
  <script src="./js/sortable.js"></script>
</html>